{
  "name": "castra-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:policies": "pnpm --filter @castra-kit/core test:policies",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "site:build": "node site/build.mjs",
    "site:deploy": "node site/build.mjs && wrangler deploy --config site/wrangler.jsonc"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.9",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "wrangler": "4.151.1"
  }
}
