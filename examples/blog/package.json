{
  "name": "blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply castra-blog --local",
    "db:seed:local": "wrangler d1 execute castra-blog --local --file=./seed.sql",
    "provision": "castra provision",
    "doctor": "castra doctor",
    "migrate": "castra migrate --remote",
    "deploy": "castra deploy",
    "destroy": "castra destroy",
    "rollback": "castra rollback"
  },
  "dependencies": {
    "@castra-kit/app": "workspace:*",
    "@castra-kit/auth": "workspace:*",
    "@castra-kit/core": "workspace:*",
    "@castra-kit/mcp": "workspace:*",
    "hono": "4.13.13",
    "kysely": "0.29.6",
    "kysely-d1": "0.4.0"
  },
  "devDependencies": {
    "@castra-kit/cli": "workspace:*",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
