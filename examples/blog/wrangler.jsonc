{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "castra-blog",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve on <name>.<subdomain>.workers.dev; no public preview URLs for non-production versions.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "castra-blog",
      // Placeholder for local development only. `castra provision` replaces it with a real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Writes (sign-in, sign-up, /mcp, table writes) per client IP; reads are not limited (ADR 0072).
  // namespace_id is any integer; apps on one account may share it, the key includes the host.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
