{
  "name": "@castra/cli",
  "version": "0.1.0",
  "description": "The castra CLI: provision, generate, migrate, deploy, test, mcp and doctor for Castra apps.",
  "license": "MIT",
  "author": "Özer Özdaş",
  "homepage": "https://github.com/ozerozdas/castra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozerozdas/castra.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/ozerozdas/castra/issues",
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "baas",
    "mcp",
    "policy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "castra": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@castra/mcp": "workspace:*",
    "castra": "workspace:*",
    "jsonc-parser": "3.3.1"
  },
  "peerDependencies": {
    "wrangler": ">=4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
