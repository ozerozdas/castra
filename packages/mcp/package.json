{
  "name": "@castra-kit/mcp",
  "version": "0.4.0",
  "description": "MCP server for Castra: stdio entry and Worker /mcp route, on the same policy engine as REST.",
  "license": "MIT",
  "author": "Mehmet \u00d6zer \u00d6zda\u015f",
  "homepage": "https://github.com/ozerozdas/castra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozerozdas/castra.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/ozerozdas/castra/issues",
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "baas",
    "mcp",
    "policy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@castra-kit/auth": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@castra-kit/core": "workspace:*",
    "hono": "4.13.13",
    "kysely": "0.29.7",
    "kysely-d1": "0.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
