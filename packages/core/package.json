{
  "name": "@castra-kit/core",
  "version": "0.3.0",
  "description": "Policy engine, schema snapshot and REST router for Castra, a Cloudflare-native BaaS on Workers and D1.",
  "license": "MIT",
  "author": "Mehmet \u00d6zer \u00d6zda\u015f",
  "homepage": "https://github.com/ozerozdas/castra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozerozdas/castra.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/ozerozdas/castra/issues",
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "baas",
    "mcp",
    "policy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:policies": "vitest run --passWithNoTests policy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261010.1",
    "@readme/openapi-parser": "9.1.0",
    "fast-check": "4.10.2",
    "kysely-d1": "0.4.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "hono": "4.13.13",
    "kysely": "0.29.6",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
