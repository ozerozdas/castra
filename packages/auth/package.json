{
  "name": "@castra-kit/auth",
  "version": "0.2.1",
  "description": "Better Auth wiring, roles and request identity for Castra.",
  "license": "MIT",
  "author": "Mehmet Özer Özdaş",
  "homepage": "https://github.com/ozerozdas/castra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozerozdas/castra.git",
    "directory": "packages/auth"
  },
  "bugs": "https://github.com/ozerozdas/castra/issues",
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "baas",
    "mcp",
    "policy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "auth:schema": "node scripts/generate-auth-schema.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "@castra-kit/core": "workspace:*",
    "hono": "4.13.13",
    "kysely": "0.29.6",
    "kysely-d1": "0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
