{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "castra-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve on <name>.<subdomain>.workers.dev; no public preview URLs for non-production versions.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "castra-app-db",
      // Placeholder for local development only. `castra provision` (or `castra deploy`) replaces it with a real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
