{
  "name": "create-castra",
  "version": "0.1.0",
  "description": "Scaffold a new Castra app: npx create-castra <name>.",
  "license": "MIT",
  "author": "Özer Özdaş",
  "homepage": "https://github.com/ozerozdas/castra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozerozdas/castra.git",
    "directory": "packages/create-castra"
  },
  "bugs": "https://github.com/ozerozdas/castra/issues",
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "baas",
    "mcp",
    "policy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "create-castra": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "!template/node_modules"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run && pnpm test:template",
    "test:template": "vitest run --root template",
    "test:e2e": "CASTRA_E2E=1 vitest run test/e2e.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.template.json"
  },
  "devDependencies": {
    "@castra-kit/auth": "workspace:*",
    "@castra-kit/cli": "workspace:*",
    "@castra-kit/mcp": "workspace:*",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261010.1",
    "castra": "workspace:*",
    "hono": "4.13.13",
    "kysely": "0.29.6",
    "kysely-d1": "0.4.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
