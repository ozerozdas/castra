{
  // Typechecks template/ inside the monorepo against the Castra sources (no build needed), like examples/blog.
  // Generated projects use template/tsconfig.json alone and resolve the published packages.
  "extends": "./template/tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "paths": {
      "@castra-kit/auth": ["../auth/src/index.ts"],
      "@castra-kit/mcp": ["../mcp/src/index.ts"],
      "castra": ["../core/src/index.ts"]
    }
  },
  "include": ["template/src", "template/test", "template/env.d.ts", "template/vitest.config.ts", "template/castra.config.ts"]
}
